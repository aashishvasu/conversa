# At least one provider key is required.
# Models whose provider is not configured are hidden from the UI, and the reason is shown in a banner in the app.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# One generic chat.completions endpoint at a time. List its models under compatible/ in MODELS.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
APP_PASSWORD=change-me

# Session token signing.
# Optional: if unset, a random key is generated each start (restart = everyone re-logs-in).
# Set it to keep sessions across restarts.
JWT_SECRET=
TOKEN_TTL_SECONDS=604800

# Global setting defaults. Conversations inherit these until a per-conversation override is set.
DEFAULT_MODEL=claude-sonnet-4-6
DEFAULT_TEMPERATURE=1.0
DEFAULT_NUM_MESSAGES=20
DEFAULT_SEND_SYSTEM_PROMPT=true
DEFAULT_MAX_TOKENS=4096
# Cheap model for auxiliary tasks: conversation titles and history compression.
DEFAULT_UTILITY_MODEL=claude-haiku-4-5
# Memory: after each reply, summarize the DEFAULT_SUMMARIZE_N turns just above the send window into a "memory" summary sent inside the system prompt.
DEFAULT_USE_MEMORY=false
DEFAULT_SUMMARIZE_N=20
# Resend the few dropped turns most relevant to the latest user message.
DEFAULT_USE_RECALL=false
# Master switch and one switch per model-callable tool (search_web, fetch_url, datetime, calculator, random).
# A disabled tool is omitted from the provider schema for that turn.
DEFAULT_TOOLS_ENABLED=true
DEFAULT_TOOL_WEB_SEARCH=true
DEFAULT_TOOL_FETCH_URL=true
DEFAULT_TOOL_DATETIME=true
DEFAULT_TOOL_CALCULATOR=true
DEFAULT_TOOL_RANDOM=true

# Hosted web fallbacks. Empty disables the corresponding provider fallback.
WEB_SEARCH_TOOL_VERSION=web_search_20250305
WEB_FETCH_TOOL_VERSION=web_fetch_20250910
WEB_FETCH_BETA=web-fetch-2025-09-10
OPENAI_WEB_SEARCH_TOOL=web_search

# App-level search for chat and research.
# First configured wins, in this order; on failure the selected model's hosted tool is the fallback.
EXA_API_KEY=
BRAVE_API_KEY=
# Base URL of a SearXNG instance with format=json enabled in its settings.yml.
SEARXNG_URL=
# Seconds a fetched page extract remains in the process-local cache.
FETCH_CACHE_TTL_SECONDS=1800

# Transient cross-device transfers. Payloads live only in process memory.
TRANSFER_TTL_SECONDS=3600
TRANSFER_MAX_ENTRY_BYTES=10000000
TRANSFER_MAX_TOTAL_BYTES=50000000
TRANSFER_MAX_ENTRIES=32

# Extra selectable models, appended to the built-in list.
# Format: provider/id:Label,id2:Label2.
# Label optional; provider optional and defaults to anthropic (so "claude-opus-5" and "anthropic/claude-opus-5" are the same model).
# Models for OPENAI_COMPATIBLE_BASE_URL use the compatible/ prefix, for example compatible/kimi-k2-thinking:Kimi K2 Thinking.
MODELS=openai/gpt-5-mini:GPT-5 mini

# Dev only: allow the Vite origin. Prod serves the SPA same-origin so this is unused.
CORS_ORIGINS=http://localhost:5173
